# 云端 Dify 正式接入说明见 dify/setup-guide.md
DIFY_BASE_URL=https://api.dify.ai/v1
# 实时网页检索（必需）
TAVILY_API_KEY=
# 预留：规划 workflow，当前版本由本地代码生成七维框架，暂不需要
DIFY_PLAN_API_KEY=
# 证据提取 workflow 的 API key（可选增强，导入 dify/evidence-workflow.dsl.yml 后取 key）
DIFY_EVIDENCE_API_KEY=
# 正式简报 workflow 的 API key（可选增强，导入 dify/brief-workflow.dsl.yml 后取 key）
DIFY_BRIEF_API_KEY=
# 单次 provider 请求超时秒数；证据提取处理 30 条来源超时时可调大到 120-180
ONLINE_RESEARCH_TIMEOUT=60
APP_DB_PATH=data/workbench.sqlite3
